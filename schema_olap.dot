
digraph structs {


rankdir="LR"


node [shape=none]

_yoyo_log [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>_yoyo_log</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_to">🔑</TD>
                    <TD PORT="id_from">id</TD>
                </TR>
            

                <TR>
                    <TD PORT="migration_hash_to">&nbsp;</TD>
                    <TD PORT="migration_hash_from">migration_hash</TD>
                </TR>
            

                <TR>
                    <TD PORT="migration_id_to">&nbsp;</TD>
                    <TD PORT="migration_id_from">migration_id</TD>
                </TR>
            

                <TR>
                    <TD PORT="operation_to">&nbsp;</TD>
