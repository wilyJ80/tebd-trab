                <TR>
                    <TD PORT="extensao_km_to">&nbsp;</TD>
                    <TD PORT="extensao_km_from">extensao_km</TD>
                </TR>
            

                <TR>
                    <TD PORT="zona_urbana_to">&nbsp;</TD>
