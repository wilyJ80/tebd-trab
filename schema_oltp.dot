
digraph structs {


rankdir="LR"


node [shape=none]

_yoyo_log [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>_yoyo_log</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_to">🔑</TD>
                    <TD PORT="id_from">id</TD>
                </TR>
            

                <TR>
                    <TD PORT="migration_hash_to">&nbsp;</TD>
                    <TD PORT="migration_hash_from">migration_hash</TD>
                </TR>
            

                <TR>
                    <TD PORT="migration_id_to">&nbsp;</TD>
                    <TD PORT="migration_id_from">migration_id</TD>
                </TR>
            

                <TR>
                    <TD PORT="operation_to">&nbsp;</TD>
                    <TD PORT="operation_from">operation</TD>
                </TR>
            

                <TR>
                    <TD PORT="username_to">&nbsp;</TD>
                    <TD PORT="username_from">username</TD>
                </TR>
            

                <TR>
                    <TD PORT="hostname_to">&nbsp;</TD>
                    <TD PORT="hostname_from">hostname</TD>
                </TR>
            

                <TR>
                    <TD PORT="comment_to">&nbsp;</TD>
                    <TD PORT="comment_from">comment</TD>
                </TR>
            

                <TR>
                    <TD PORT="created_at_utc_to">&nbsp;</TD>
                    <TD PORT="created_at_utc_from">created_at_utc</TD>
                </TR>
            
            </TABLE>
        >];
        
