                    <TD COLSPAN="2"><B>linhas</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_linha_to">🔑</TD>
                    <TD PORT="id_linha_from">id_linha</TD>
                </TR>
            

                <TR>
                    <TD PORT="id_empresa_to">&nbsp;</TD>
                    <TD PORT="id_empresa_from">id_empresa</TD>
                </TR>
            

                <TR>
                    <TD PORT="codigo_linha_to">&nbsp;</TD>
                    <TD PORT="codigo_linha_from">codigo_linha</TD>
                </TR>
            

                <TR>
                    <TD PORT="nome_linha_to">&nbsp;</TD>
                    <TD PORT="nome_linha_from">nome_linha</TD>
