
digraph structs {


rankdir="LR"


node [shape=none]

bairros [label=<
            <TABLE BORDER="0" CELLSPACING="0" CELLBORDER="1">
                <TR>
                    <TD COLSPAN="2"><B>bairros</B></TD>
                </TR>
            
                <TR>
                    <TD PORT="id_bairro_to">🔑</TD>
                    <TD PORT="id_bairro_from">id_bairro</TD>
                </TR>
            

                <TR>
                    <TD PORT="nome_bairro_to">&nbsp;</TD>
                    <TD PORT="nome_bairro_from">nome_bairro</TD>
                </TR>
            

                <TR>
                    <TD PORT="zona_urbana_to">&nbsp;</TD>
                    <TD PORT="zona_urbana_from">zona_urbana</TD>
                </TR>
            
            </TABLE>
        >];
        
