pontos_parada:id_bairro_from:e -> bairros:id_bairro_to:w
validacoes_bilhetagem:id_tipo_tarifa_from:e -> tipos_tarifa:id_tipo_tarifa_to:w
validacoes_bilhetagem:id_viagem_from:e -> viagens_diarias:id_viagem_to:w
veiculos:id_empresa_from:e -> empresas_onibus:id_empresa_to:w
linhas:id_empresa_from:e -> empresas_onibus:id_empresa_to:w
viagens_diarias:id_ponto_chegada_from:e -> pontos_parada:id_ponto_to:w
viagens_diarias:id_ponto_partida_from:e -> pontos_parada:id_ponto_to:w
viagens_diarias:id_linha_from:e -> linhas:id_linha_to:w
viagens_diarias:id_veiculo_from:e -> veiculos:id_veiculo_to:w

}
